{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": "/api/admin/$1" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ],
  "outputDirectory": "."
}