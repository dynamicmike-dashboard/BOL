{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/admin/(.*)", "destination": "/api/admin/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "outputDirectory": "dist/client"
}